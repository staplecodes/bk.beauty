{
  "installCommand": "npm install --force",
  "functions": {
    "api/[...path].ts": {
      "includeFiles": "{data/**,uploads/**,src/db/**}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/[...path]" },
    { "source": "/uploads/(.*)", "destination": "/api/[...path]" }
  ]
}