# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server configuration. Set these only on the server; never use a VITE_ prefix.
PORT="3000"
NODE_ENV="development"
# Must match the existing administrator account in data/bkbeauty_db.json.
ADMIN_EMAIL="admin@bkbeauty.dz"
# Required for signing admin sessions; use a random secret of at least 32 bytes.
JWT_SECRET=""
